{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": ""
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "createUpdaterArtifacts": false,
    "resources": {
      "../build/distribution-resources/": ""
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64 | libgtk-3-0",
          "libglib2.0-0t64 | libglib2.0-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "librsvg2-2",
          "bubblewrap",
          "zenity"
        ]
      },
      "rpm": {
        "depends": [
          "bubblewrap",
          "zenity"
        ],
        "compression": {
          "type": "zstd",
          "level": 6
        }
      }
    }
  }
}
