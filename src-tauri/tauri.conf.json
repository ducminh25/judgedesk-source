{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JudgeDesk",
  "version": "1.6.1",
  "identifier": "com.themisv2.judge",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JudgeDesk",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "resizable": true,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://localhost:5173 ws://127.0.0.1:5173",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["judgedesk"],
        "name": "JudgeDesk Contest",
        "description": "JudgeDesk Contest File",
        "role": "Editor"
      }
    ],
    "resources": {
      "../sandbox/**/*": "sandbox/",
      "../compiler-compat/include/bits/stdc++.h": "compiler-compat/include/bits/stdc++.h"
    },
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/server", "binaries/judgedesk-executor"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64 | libgtk-3-0",
          "libglib2.0-0t64 | libglib2.0-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "librsvg2-2",
          "bubblewrap",
          "zenity",
          "g++",
          "python3"
        ],
        "section": "education",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "bubblewrap",
          "zenity",
          "python3",
          "gcc-c++",
          "glibc-static",
          "libstdc++-static"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerHooks": "installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMjkxNzkwRTVBMzAxNUUKUldSZUFhUGxrQmNwUFh5ZWtaM0xTT09JVDE3Y1RQcHBNUXZPY1hqS3BZejlxNXl5QS9aV0lseGgK",
      "endpoints": [
        "https://github.com/ducminh25/judgedesk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
