{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JudgeDesk",
  "version": "1.2.3",
  "identifier": "com.themisv2.judge",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JudgeDesk",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "resizable": true,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../sandbox/**/*": "sandbox/"
    },
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/server", "binaries/judgedesk-executor"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerHooks": "installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMjkxNzkwRTVBMzAxNUUKUldSZUFhUGxrQmNwUFh5ZWtaM0xTT09JVDE3Y1RQcHBNUXZPY1hqS3BZejlxNXl5QS9aV0lseGgK",
      "endpoints": [
        "https://github.com/ducminh25/themis-v2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
